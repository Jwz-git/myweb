{
  "name": "jwz-blog",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "content:build": "tsx packages/content/src/build.ts",
    "content:check": "tsx packages/content/src/build.ts --check",
    "dev": "npm run content:build && npm run dev -w @jwz/web",
    "build": "npm run content:build -- --production && npm run build -w @jwz/web",
    "build:pages": "cross-env VITE_BASE_PATH=/Blog/ npm run build",
    "build:vps": "cross-env VITE_BASE_PATH=/ VITE_SERVER_FEATURES=true npm run build",
    "dev:api": "npm run dev -w @jwz/api",
    "test": "vitest run",
    "typecheck": "npm run build -w @jwz/api && npm run content:check",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.52.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.26.0",
    "eslint-plugin-vue": "^10.1.0",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^38.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.3",
    "vue-eslint-parser": "^10.1.3"
  }
}
